{
  "name": "builder",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/builder/src",
  "projectType": "application",
  "prefix": "builder",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/builder",
        "main": "apps/builder/src/main.ts",
        "tsConfig": "apps/builder/tsconfig.app.json",
        "assets": ["apps/builder/src/assets"],
        "generatePackageJson": true,
        "platform": "node",
        "bundle": true,
        "thirdParty": false,
        "dependenciesFieldType": "dependencies",
        "target": "node22",
        "format": ["esm"],
        "esbuildOptions": {
          "logLevel": "info"
        }
      },
      "configurations": {
        "production": {
          "minify": true,
          "fileReplacements": [
            {
              "replace": "apps/builder/src/environment/environment.ts",
              "with": "apps/builder/src/environment/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "builder:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "builder:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  },
  "tags": []
}
