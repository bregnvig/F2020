# Angular 22 upgrade: @angular/fire (21-rc) and @ngrx (22 beta) have not
# published stable Angular-22 builds yet, so their ^21 peer ranges are
# force-satisfied here (see the "overrides" block in package.json). Required
# for npm install / npm ci to succeed until upstream ships Angular-22 releases.
legacy-peer-deps=true
